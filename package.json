{
  "name": "apoorv-developer-world",
  "version": "1.0.0",
  "description": "Ultra-Premium Interactive 3D MERN Developer Portfolio for Apoorv Sharma",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "npm --prefix client run dev",
    "server:dev": "npm --prefix server run dev",
    "client:build": "npm --prefix client run build",
    "server:start": "npm --prefix server start",
    "build": "npm run client:build",
    "postinstall": "npm --prefix client install",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install"
  },
  "keywords": [
    "mern",
    "portfolio",
    "threejs",
    "react-three-fiber",
    "fullstack",
    "developer",
    "react-bits"
  ],
  "author": "Apoorv Sharma",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
