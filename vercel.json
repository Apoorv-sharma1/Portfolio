{
  "version": 2,
  "installCommand": "npm install && npm --prefix client install",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/resume/pdf",
      "destination": "/api/resume.js?format=pdf"
    },
    {
      "source": "/api/resume/docx",
      "destination": "/api/resume.js?format=docx"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/resume.pdf",
      "destination": "/resume.pdf"
    },
    {
      "source": "/resume.docx",
      "destination": "/resume.docx"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
