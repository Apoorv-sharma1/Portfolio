{
  "version": 2,
  "buildCommand": "npm run client:build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/resume.pdf",
      "destination": "/resume.pdf"
    },
    {
      "source": "/resume.docx",
      "destination": "/resume.docx"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
